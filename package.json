{
  "name": "qa-sdet-challenge",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.{js,ts}"
    ]
  },
  "scripts": {
    "test": "npm run test:e2e",
    "test:smoke": "cypress run --env tags='@smoke'",
    "test:regression": "cypress run --env tags='@regression'",
    "test:e2e": "cypress run --spec 'cypress/e2e/features/**/*.feature'",
    "test:api": "cypress run --spec 'cypress/e2e/features/*api.feature'",
    "lint": "eslint .",
    "report": "cypress run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "cypress": "^15.20.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript": "^5.9.3"
  }
}
